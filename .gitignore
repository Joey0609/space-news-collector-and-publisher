# ---- 环境变量与密钥（绝不上传）----
.env
*.env
!*.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 数据 / 状态 / 输出（可能含隐私或体积大）----
*.db
*.sqlite
*.bak
output/
logs/
*.log
cookies*.json
webui.json
state.json

# ---- 自检临时产物（会反复重建，不入库）----
selftest/.sandbox/
# ---- 本地调试脚本与抓取样本（不入库）----
test/
# ---- 新版运行期数据与本地配置 ----
data/*
!data/README.md
config/


# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
.DS_Store
desktop.ini
