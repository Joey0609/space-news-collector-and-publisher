# 航小麦 · 环境变量示例
# 用法：复制本文件为同目录的 .env，并填入真实值。
#   .env 已被 .gitignore 忽略，不会上传到仓库。
#   Windows:  copy .env.example .env

# HTTP 代理（访问 X / pbs.twimg.com 需要，国内直连不通）
PROXY_URL=

# ---- 模型 API（翻译+新闻判定+标签 / AI兜底 共用）----
# 没有内置服务商：下面三项必须自己填，缺任一项就整段跳过（不会发半截请求）。
# 协议三选一：
#   openai     OpenAI 兼容的 /chat/completions（OpenAI、通义、Moonshot、vLLM、Ollama、one-api 等）
#   responses  OpenAI Responses API 的 /responses
#   anthropic  Anthropic 兼容的 /messages（Claude 官方或中转网关）
MODEL_PROTOCOL=openai

# API 地址：写到版本号为止，不要带 /chat/completions
#   OpenAI          https://api.openai.com/v1
#   Anthropic       https://api.anthropic.com/v1
#   本机 Ollama     http://127.0.0.1:11434/v1
MODEL_API_BASE=

# 模型名称，例如 gpt-4o-mini / claude-3-5-sonnet-latest / qwen-max
MODEL_NAME=

# API Key
MODEL_API_KEY=

# 可选：单次请求超时秒数
MODEL_TIMEOUT=90

# 可选：单次输出上限。0 = 不显式传，交给服务端默认（anthropic 协议为 0 时用 4096 兜底）。
# 译文 + 是不是新闻 + 标签是一次性返回的 JSON，上限太小会被截断（日志会报 OutputTruncated）。
MODEL_MAX_TOKENS=0

# 翻译+打标：每轮处理都会自动补跑"没翻译过 / 翻译失败"的条目；
# 失败的单条最多重试这么多次，超过就不再重试（可调大后再跑）。
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_PAUSE_SECONDS=0.5

# 判"不重复"那盏灯时，给模型对比的"最近已入库标题"条数；0 = 不给清单（只看文本里的旧闻线索）
AI_REPEAT_CONTEXT=40

# 限流/超时属于"临时失败"：同一轮内当场重试 ANALYSIS_INLINE_RETRIES 次，
# 每次间隔 ANALYSIS_RATE_LIMIT_WAIT 秒，并且**不消耗**上面的重试次数。
# 免费/共享模型经常 429（该模型访问量过大），这两个值可以调大。
ANALYSIS_INLINE_RETRIES=2
ANALYSIS_RATE_LIMIT_WAIT=20

# X 登录 cookies 文件路径（twscrape 用）
COOKIES_PATH=

# X 遍历名单固定读取 collect/sources/x/x_accounts.csv，表头为：名字,性质。
# 名字填 X 用户名（可带 @）；性质暂可空，分类仅 official/media/photographer/enthusiast/others。
# 编辑名单后下一轮采集自动生效。

# 可选：启用哪些采集源（逗号分隔）；留空 = 跑 collect/sources/ 下所有已注册的源。
# 已注册 x,rss,snapi,sina；rss 内含19个独立订阅。采集不按主题筛选。
SOURCES=
WEB_COLLECT_INTERVAL_SECONDS=900
# X 保留原 COLLECT_INTERVAL_SECONDS；新增来源不共用这个等待间隔。

# 可选：每轮扫描账号数（分批防限流）
SCAN_BATCH=40
