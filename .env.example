# 航小麦 · 环境变量示例
# 用法：复制本文件为同目录的 .env，并填入真实值。
#   .env 已被 .gitignore 忽略，不会上传到仓库。
#   Windows:  copy .env.example .env

# HTTP 代理（访问 X / pbs.twimg.com 需要，国内直连不通）
PROXY_URL=

# DeepSeek API Key（翻译 / 打标 / AI兜底 用）
DEEPSEEK_KEY=
DEEPSEEK_MODEL=deepseek-chat

# X 登录 cookies 文件路径（twscrape 用）
COOKIES_PATH=

# 监控的“关注列表”账号（航小麦读它的 following 名单）
WATCH_ACCOUNT=Space_Alioth

# 可选：直接指定要抓的账号（逗号分隔）；留空则用 WATCH_ACCOUNT 的关注列表
NEWS_ACCOUNTS=

# 可选：每轮扫描账号数（分批防限流）
SCAN_BATCH=40
